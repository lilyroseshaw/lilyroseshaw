# Copy this file to .env and fill in real values. Never commit .env.

# --- Google OAuth (from Google Cloud Console > APIs & Services > Credentials) ---
# Create an "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI configured on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Local encryption ---
# Key used to encrypt the OAuth refresh token at rest in the local SQLite DB.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_MONSTER_SECRET_KEY=replace-with-a-generated-fernet-key

# --- App ---
# Local-only session cookie signing secret (any random string).
SESSION_SECRET=replace-with-a-random-string

# Where the SQLite database file is stored.
DATABASE_PATH=./data/cookie_monster.db

# Host/port the local server binds to.
APP_HOST=127.0.0.1
APP_PORT=8000
