# Copy this file to .env and fill in real values. Never commit .env.

# --- Google OAuth (from Google Cloud Console > APIs & Services > Credentials) ---
# Create an "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI configured on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Local encryption ---
# Key used to encrypt the OAuth refresh token at rest in the local SQLite DB.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_MONSTER_SECRET_KEY=replace-with-a-generated-fernet-key

# --- App ---
# Local-only session cookie signing secret (any random string).
SESSION_SECRET=replace-with-a-random-string

# Where the SQLite database file is stored.
DATABASE_PATH=./data/cookie_monster.db

# Host/port the local server binds to.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Deletion-method research (all optional) ---
# Master switch. Set to false to disable outbound research entirely - every
# unresolved company will show "Deletion method not verified yet" instead.
DELETION_RESEARCH_ENABLED=true

# Optional: lets the research provider fall back to a real search engine
# for companies its own-domain crawl can't find a privacy page for.
# Get a key at https://brave.com/search/api/. Leave blank to skip this tier
# (the same-domain crawl still runs and works without it).
BRAVE_SEARCH_API_KEY=

# Optional: lets the research provider use Claude to parse privacy-policy
# pages the regex/keyword pass can't confidently read. Leave blank to skip
# this tier (regex-only extraction still runs without it). The model is
# only ever used to locate facts already present on a fetched page, never
# to invent a URL/email - see app/research_extract.py.
ANTHROPIC_API_KEY=
DELETION_RESEARCH_LLM_MODEL=claude-haiku-4-5-20251001

# How long a verified deletion recipe is trusted before Cookie Monster
# re-checks it (days), and how long to wait before retrying a company that
# couldn't be verified (days).
DELETION_RECIPE_FRESHNESS_DAYS=150
DELETION_RECIPE_RETRY_COOLDOWN_DAYS=7

# Background enrichment worker cadence.
DELETION_QUEUE_INTERVAL_SECONDS=60
DELETION_QUEUE_BATCH_SIZE=3
